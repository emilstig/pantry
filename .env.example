# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Resend (weekly reminder emails)
RESEND_API_KEY=""
REMINDER_EMAIL="you@example.com"
# Optional: verified sender in Resend. Defaults to onboarding@resend.dev
REMINDER_FROM_EMAIL="Pantry Manager <onboarding@resend.dev>"
# Public app URL used as the "Open Pantry Manager" button in reminder emails
APP_URL="https://pantry-gilt-chi.vercel.app"

# Protects /api/keepalive and /api/reminder (required in production)
# Generate with: openssl rand -hex 32
CRON_SECRET=""
